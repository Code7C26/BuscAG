{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:pwa-browser": "node tests/pwa-browser.mjs",
    "qa:local": "node scripts/qa-local.mjs",
    "test:e2e": "playwright test",
    "qa:browser:install": "playwright install chromium",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:staging": "node scripts/run-staging.mjs",
    "build:staging": "node scripts/run-staging.mjs --build",
    "check:staging-public": "node scripts/check-staging-public.mjs",
    "test:staging-frontend": "tsx --test tests/staging-frontend.test.ts",
    "build": "vite build",
    "test": "tsx --test src/utils/*.test.ts tests/production.test.mjs tests/service-worker.test.mjs tests/diagnostic.test.mjs tests/storage-backup.test.mjs tests/restore-safety.test.mjs tests/mail-templates.test.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "check:diagnostic": "node scripts/check-supabase-diagnostic.mjs",
    "test:backend": "node scripts/test-backend-matrix.mjs pglite",
    "test:backend:postgres": "node scripts/test-backend-matrix.mjs postgres",
    "backup:storage": "node scripts/backup-storage.mjs",
    "test:restore:postgres": "node scripts/test-backup-restore.mjs",
    "prepare:staging": "node scripts/prepare-staging.mjs",
    "test:staging-tools": "node --test tests/staging-prepare.test.mjs",
    "test:staging-tls": "node --test tests/staging-tls.test.mjs",
    "build:release": "node scripts/prepare-release.mjs",
    "test:release": "tsx --test tests/release.test.ts",
    "qa:staging:live": "node scripts/staging-live.mjs",
    "test:staging-live-tools": "node --test tests/staging-live.test.mjs",
    "build:presentation": "node scripts/build-presentation.mjs",
    "test:presentation": "tsx --test tests/presentation.test.ts",
    "test:presentation-browser": "node tests/presentation-browser.mjs",
    "demo:worker": "node scripts/staging-match-worker.mjs",
    "test:staging-worker-tools": "node --test tests/staging-worker-tools.test.mjs",
    "test:visitors": "node --test tests/visitor-auth.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "jsqr": "^1.4.0",
    "pg": "8.16.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  }
}
