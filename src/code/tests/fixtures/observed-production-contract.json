    },
    {
      "conname": "messages_recipient_id_fkey",
      "contype": "f",
      "relname": "messages",
      "definition": "FOREIGN KEY (recipient_id) REFERENCES profiles(id) ON DELETE CASCADE",
      "convalidated": true
    },
    {
      "conname": "messages_sender_id_fkey",
      "contype": "f",
      "relname": "messages",
      "definition": "FOREIGN KEY (sender_id) REFERENCES profiles(id) ON DELETE CASCADE",
