    {
      "conname": "notifications_related_user_id_fkey",
      "contype": "f",
      "relname": "notifications",
      "definition": "FOREIGN KEY (related_user_id) REFERENCES profiles(id) ON DELETE SET NULL",
      "convalidated": true
    },
    {
      "conname": "notifications_type_check",
      "contype": "c",
      "relname": "notifications",
      "definition": "CHECK ((type = ANY (ARRAY['message'::text, 'match'::text, 'system'::text, 'recovered'::text])))",
