{
  "name": "buscag-cinematic-trailer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets.mjs && node scripts/audio.mjs",
    "capture": "tsx scripts/capture.ts",
    "studio": "remotion studio src/index.ts --port=3100",
    "stills": "node scripts/render.mjs --stills",
    "render": "node scripts/render.mjs",
    "render:draft": "node scripts/render.mjs --draft",
    "render:smoke": "node scripts/render.mjs --smoke",
    "verify": "node scripts/verify.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "audio:v2": "node v2/audio.mjs",
    "capture:v2": "tsx v2/capture.ts",
    "studio:v2": "remotion studio v2/index.ts --port=3102",
    "stills:v2": "node v2/render.mjs --stills",
    "render:v2": "node v2/render.mjs",
    "smoke:v2": "node v2/render.mjs --smoke",
    "verify:v2": "node v2/verify.mjs",
    "test:v2": "node --test v2/tests.mjs",
    "sheet:v2": "node v2/contact-sheet.mjs"
  },
  "dependencies": {
    "remotion": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "@fontsource-variable/manrope": "5.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "19.0.12",
    "@types/node": "22.15.3",
    "typescript": "5.8.2",
    "tsx": "4.21.0"
  }
}
